# gpt-load GitHub Actions Secrets 示例
# 复制为同目录的 .env.secrets（仓库中的 deploy/.env.secrets）后填写；真实值不要提交到 Git。
# 在仓库根目录的 PowerShell 执行 .\deploy\sync-secrets.ps1 同步到 GitHub。
#
# 节外的键写入仓库级 Secrets，所有服务器共用。
# 每个 [env:名字] 节对应一台服务器，写入同名 GitHub Environment 的 Secrets；
# 节的先后顺序就是部署顺序，脚本据此写入仓库变量 DEPLOY_TARGETS。
# 环境名只能用字母、数字、点、下划线和连字符。仓库公开，环境名所有人可见，不要用 IP 或域名命名。

# 部署结果通知
GMAIL_USERNAME=your_email@gmail.com
GMAIL_PASSWORD=your_app_password
GMAIL_TO=notify_target@example.com

# 镜像仓库
REGISTRY=docker.example.com
REGISTRY_USERNAME=your_registry_username
REGISTRY_PASSWORD=your_registry_password
REGISTRY_REPO=docker.example.com/gpt-load

# 部署服务器：每台一节。SSH_PORT 可省略（默认 22），其余必填；这些键不能写在节外。
[env:prod-1]
SSH_HOST=server1.ip.or.domain
SSH_PORT=22
SSH_USER=deploy_user
SSH_PASSWORD=your_ssh_password
DEPLOY_DIR=/home/DockerCompose/gpt-load

[env:prod-2]
SSH_HOST=server2.ip.or.domain
SSH_PORT=22
SSH_USER=deploy_user
SSH_PASSWORD=your_ssh_password
DEPLOY_DIR=/home/DockerCompose/gpt-load
